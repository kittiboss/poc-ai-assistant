generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Provider {
  MOCK
  OLLAMA
  OPENAI
  ANTHROPIC
  GEMINI
  GROQ
  OPENROUTER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  INTERRUPTED
  ERROR
}

enum RequestStatus {
  PENDING
  STREAMING
  COMPLETED
  CANCELLED
  ERROR
}

enum UsageKind {
  ACTUAL
  ESTIMATED
  SYNTHETIC
}

enum UsageOperation {
  CHAT
  EMBEDDING
}

enum PricingStrategy {
  PASS_THROUGH
  PERCENTAGE_MARKUP
  FIXED_RATE
  SIMULATION
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  externalId   String         @unique
  username     String
  email        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  roles        UserRole[]
  conversations Conversation[]
  usageRecords UsageRecord[]
  modelPermissions UserModelPermission[]
  auditLogs    AuditLog[]
  instructions String @default("") @db.Text
  department String @default("")
  projects Project[]
  memories Memory[]
  reservations UsageReservation[]
  attachments Attachment[]
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  roles RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model AIModel {
  id              String   @id
  displayName     String
  provider        Provider
  providerModelId String
  enabled         Boolean  @default(false)
  allowedRoles    String[]
  contextWindow   Int
  capabilities    String[]
  local           Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        Message[]
  usageRecords    UsageRecord[]
  pricing         PricingConfiguration?
  permissions     UserModelPermission[]
  @@index([provider, enabled])
}

model UserModelPermission {
  userId String @db.Uuid
  modelId String
  allowed Boolean
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  model AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  @@id([userId, modelId])
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  pinned Boolean @default(false)
  archived Boolean @default(false)
  projectId String? @db.Uuid
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  usageRecords UsageRecord[]
  @@index([userId, deletedAt, updatedAt])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  role           MessageRole
  content        String        @db.Text
  status         MessageStatus @default(COMPLETED)
  modelId        String?
  requestId      String?       @unique
  citations Json @default("[]")
  feedback Int?
  feedbackComment String? @db.VarChar(1000)
  metadata Json @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  model        AIModel?      @relation(fields: [modelId], references: [id])
  @@index([conversationId, createdAt])
}

model UsageRecord {
  id             String        @id @default(uuid()) @db.Uuid
  requestId      String        @unique
  userId         String        @db.Uuid
  conversationId String?       @db.Uuid
  modelId        String
  operation      UsageOperation @default(CHAT)
  pricingVersionId String?     @db.Uuid
  provider       Provider
  inputTokens    Int
  outputTokens   Int
  totalTokens    Int
  durationMs     Int
  status         RequestStatus
  usageKind      UsageKind
  currency       String        @default("USD")
  actualProviderCost Decimal   @db.Decimal(24, 12)
  customerCharge Decimal       @db.Decimal(24, 12)
  simulatedProviderCost Decimal @db.Decimal(24, 12)
  simulatedCustomerCharge Decimal @db.Decimal(24, 12)
  pricingSnapshot Json
  createdAt      DateTime      @default(now())
  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  model        AIModel      @relation(fields: [modelId], references: [id])
  pricingVersion PricingVersion? @relation(fields: [pricingVersionId], references: [id])
  @@index([userId, createdAt])
  @@index([modelId, createdAt])
}

model PricingConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  modelId   String   @unique
  createdAt DateTime @default(now())
  model     AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  versions  PricingVersion[]
}

model PricingVersion {
  id                String          @id @default(uuid()) @db.Uuid
  configurationId   String          @db.Uuid
  version           Int
  strategy          PricingStrategy
  providerInputRate Decimal         @db.Decimal(24, 12)
  providerOutputRate Decimal        @db.Decimal(24, 12)
  cachedInputRate   Decimal?        @db.Decimal(24, 12)
  additionalFee     Decimal         @default(0) @db.Decimal(24, 12)
  customerInputRate Decimal         @default(0) @db.Decimal(24, 12)
  customerOutputRate Decimal        @default(0) @db.Decimal(24, 12)
  markupPercent     Decimal         @default(0) @db.Decimal(12, 6)
  simulationInputRate Decimal       @default(0) @db.Decimal(24, 12)
  simulationOutputRate Decimal      @default(0) @db.Decimal(24, 12)
  currency          String          @default("USD")
  effectiveAt       DateTime        @default(now())
  createdBy         String?
  createdAt         DateTime        @default(now())
  configuration PricingConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]
  @@unique([configurationId, version])
  @@index([configurationId, effectiveAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id])
  @@index([entityType, entityId, createdAt])
}

model ApplicationSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String @db.VarChar(120)
  instructions String @default("") @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  sources Source[]
  @@index([userId])
}

model Source {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  filename String @db.VarChar(200)
  byteSize Int
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks SourceChunk[]
  @@index([projectId])
}

model SourceChunk {
  id String @id @default(uuid()) @db.Uuid
  sourceId String @db.Uuid
  ordinal Int
  page Int?
  content String @db.Text
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@unique([sourceId, ordinal])
}

/// A document attached to a chat message; only its extracted text is kept.
/// Messages reference it in metadata.attachments, so a branched chat keeps its files.
model Attachment {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  filename String @db.VarChar(200)
  byteSize Int
  /// PDFs only.
  pageCount Int?
  charCount Int
  /// Extracted text as the model reads it; PDF pages are marked [Page n].
  content String @db.Text
  /// Null until a message sends it; unsent attachments are removed after 24 hours.
  sentAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([sentAt, createdAt])
}

model Memory {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  content String @db.VarChar(500)
  enabled Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PromptTemplate {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  description String @default("") @db.VarChar(500)
  systemPrompt String @db.Text
  allowedModels String[]
  allowedRoles String[]
  temperature Float @default(0.7)
  maxOutputTokens Int @default(1024)
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model QuotaPolicy {
  id String @id @default(uuid()) @db.Uuid
  scope String
  subject String
  dailyRequests Int?
  dailyTokens Int?
  perRequestTokens Int?
  dailySimulatedBudget Decimal? @db.Decimal(24, 12)
  @@unique([scope, subject])
}

model UsageReservation {
  id String @id
  userId String @db.Uuid
  modelId String
  department String
  roles String[]
  external Boolean
  tokens Int
  simulatedCost Decimal @db.Decimal(24, 12)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

/// Product catalog from the supplied schema.sql; snake_case columns are kept as delivered.
model Product {
  productId     Int      @id @map("product_id")
  sku           String   @unique @db.VarChar(20)
  name          String   @db.VarChar(150)
  description   String
  category      String   @db.VarChar(50)
  subcategory   String   @db.VarChar(50)
  brand         String   @db.VarChar(50)
  price         Decimal  @db.Decimal(10, 2)
  costPrice     Decimal  @map("cost_price") @db.Decimal(10, 2)
  currency      String   @default("USD") @db.Char(3)
  stockQuantity Int      @default(0) @map("stock_quantity")
  weightKg      Decimal? @map("weight_kg") @db.Decimal(8, 2)
  color         String?  @db.VarChar(50)
  material      String?  @db.VarChar(100)
  rating        Decimal? @db.Decimal(2, 1)
  reviewCount   Int      @default(0) @map("review_count")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @map("updated_at") @db.Timestamp(6)

  @@map("products")
}

/// Embedded passages for retrieval. Written with raw SQL (Prisma cannot write the vector column);
/// the HNSW index on "embedding" is created in the migration.
model KnowledgeChunk {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source         String
  sourceId       String
  title          String
  content        String
  contentHash    String
  embeddingModel String
  embedding      Unsupported("vector(768)")
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @default(now()) @updatedAt

  @@unique([source, sourceId, embeddingModel])
}
