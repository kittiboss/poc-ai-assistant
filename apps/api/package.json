{
  "name": "@enterprise/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy && npm run prisma:seed && node dist/main.js",
    "test": "prisma generate && vitest run --dir src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@enterprise/shared": "*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.10.1",
    "big.js": "7.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jose": "6.0.11",
    "pdfjs-dist": "6.4.299",
    "mammoth": "1.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.3",
    "@types/big.js": "6.2.2",
    "@types/node": "22.15.30",
    "prisma": "6.10.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "5.0.4"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}

