# Copy to .env. Defaults are local-development only; change every secret outside a POC.
POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=postgresql://enterprise_ai:local_dev_only@postgres:5432/enterprise_ai?schema=public

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local_admin_only
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=enterprise-ai
OIDC_AUDIENCE=enterprise-ai-api

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=enterprise-ai
NEXT_PUBLIC_OIDC_CLIENT_ID=enterprise-ai-web

LITELLM_MASTER_KEY=local-litellm-key-change-me
LITELLM_URL=http://litellm:4000
MOCK_PROVIDER_URL=http://mock-provider:4010/v1
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Paid providers require this switch, valid credentials, an administrator-created route,
# and an enabled model registry entry. They are deliberately not in LiteLLM's default config.
ENABLE_EXTERNAL_PROVIDERS=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Upper bound sent to every model provider. The explicit Gemini smoke test
# overrides this to 32 to keep its single request minimal.
AI_MAX_OUTPUT_TOKENS=512

API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
VALKEY_URL=redis://valkey:6379
LOG_CONTENT=false

