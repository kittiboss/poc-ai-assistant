# Copy to .env. Defaults are local-development only; change every secret outside a POC.
POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=postgresql://enterprise_ai:local_dev_only@postgres:5432/enterprise_ai?schema=public

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local_admin_only
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=enterprise-ai
OIDC_AUDIENCE=enterprise-ai-api

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=enterprise-ai
NEXT_PUBLIC_OIDC_CLIENT_ID=enterprise-ai-web
# Web brand, chosen at build time (apps/web/config/brands): default, acme
NEXT_PUBLIC_BRAND=default

LITELLM_MASTER_KEY=local-litellm-key-change-me
LITELLM_URL=http://litellm:4000
MOCK_PROVIDER_URL=http://mock-provider:4010/v1
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Paid providers require this switch, valid credentials, an administrator-created route,
# and an enabled model registry entry. They are deliberately not in LiteLLM's default config.
ENABLE_EXTERNAL_PROVIDERS=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Keep false until Settings → Billing confirms this organization is Free tier.
GROQ_FREE_TIER_CONFIRMED=false
OPENROUTER_API_KEY=
# Free-only router; the proxy rejects every other model and routing override.
OPENROUTER_MODEL=openrouter/free

# Upper bound sent to every model provider. Each credential proxy enforces it again
# before anything leaves the installation.
AI_MAX_OUTPUT_TOKENS=1024

# Installation-wide daily ceiling (UTC) across ALL external providers, counted
# from usage records. Requests over either limit are refused with HTTP 429.
# 0 blocks external providers entirely. Local mock/Ollama are never limited.
EXTERNAL_DAILY_REQUEST_LIMIT=100
EXTERNAL_DAILY_TOKEN_LIMIT=100000

# Product-catalog retrieval (RAG). Unset, the base stack uses the offline mock-embedding
# and the Gemini overlays use gemini-embedding, which an admin must still enable in the
# model registry. Changing the model requires re-indexing (Admin > Product catalog).
# RAG_EMBEDDING_MODEL=mock-embedding
RAG_TOP_K=5
# Indexing with an external model is paced: Gemini's free tier counts each text against
# a 100-per-minute quota. 25 texts every 15.5 s stays under it, and small batches keep
# each reservation well inside EXTERNAL_DAILY_TOKEN_LIMIT.
RAG_EXTERNAL_BATCH_SIZE=25
RAG_EXTERNAL_BATCH_INTERVAL_MS=15500
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

API_PORT=3001
# Swagger UI at http://localhost:3001/api/docs (OAuth2 PKCE login via Keycloak).
# Set SWAGGER_ENABLED=false for customer deployments.
SWAGGER_ENABLED=true
API_PUBLIC_URL=http://localhost:3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
VALKEY_URL=redis://valkey:6379
LOG_CONTENT=false

